{
  "version": 2,
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "node_modules/.prisma/client/**"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api" },
    { "src": "/(?!(api|assets|.*\\.(?:js|css|png|jpg|jpeg|svg|ico|webp|woff2?))).*", "dest": "/index.html" }
  ]
}