{
  "version": 2,
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "outputFileTracingIncludes": {
        "node_modules/.prisma/client/query_compiler_bg.wasm": "./node_modules/.prisma/client/query_compiler_bg.wasm",
        "node_modules/.prisma/client/query_engine_bg.wasm": "./node_modules/.prisma/client/query_engine_bg.wasm",
        "node_modules/.prisma/client/schema.prisma": "./node_modules/.prisma/client/schema.prisma",
        "node_modules/.prisma/client/query_compiler_bg.js": "./node_modules/.prisma/client/query_compiler_bg.js",
        "node_modules/.prisma/client/query_engine_bg.js": "./node_modules/.prisma/client/query_engine_bg.js"
      }
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api" },
    { "src": "/(?!(api|assets|.*\\.(?:js|css|png|jpg|jpeg|svg|ico|webp|woff2?))).*", "dest": "/index.html" }
  ]
}