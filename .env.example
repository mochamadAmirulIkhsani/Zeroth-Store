PORT=4000
NODE_ENV=development
# Wajib: secret acak panjang (min 32 char). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Origin yang diizinkan CORS (pisahkan dengan koma jika lebih dari satu).
# Kosongkan untuk same-origin saja (deploy monolith Vercel — frontend+API satu domain).
# Dev lokal: http://localhost:5173
CORS_ORIGIN=
# Opsional: base URL API untuk frontend saat build (Vite).
# Kosongkan = same-origin (relatif /api). Dev terpisah: http://localhost:4000
VITE_API_BASE_URL=

# Optional: first-run admin account (seeded to the User table)
# ADMIN_EMAIL=admin@zeroth.store
# ADMIN_NAME=Admin Zeroth
# ADMIN_PASSWORD= (wajib diisi untuk seed awal; admin akan di-seed dengan nilai ini)

# Supabase Postgres connection string (Project Settings > Database > Connection string)
# DATABASE_URL = transaction pooler (:6543, pgbouncer) — dipakai runtime API.
#   Catatan: pooler tidak mendukung interactive $transaction — kode memakai operasi non-transaksional.
# DIRECT_URL = koneksi direct (:5432) — dipakai CLI Prisma (db push / migrate / seed).
DATABASE_URL=postgresql://user:***@host:6543/postgres?pgbouncer=true&sslmode=require&schema=public
DIRECT_URL=postgresql://user:***@host:5432/postgres?sslmode=require&schema=public